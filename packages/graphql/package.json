{
  "name": "@eastgate/graphql",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./apollo": {
      "types": "./src/apollo/index.ts",
      "default": "./src/apollo/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "lint": "eslint .",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@apollo/client": "^4.2.10",
    "@apollo/client-integration-tanstack-start": "^0.14.5-rc.0",
    "graphql": "^16.14.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eastgate/eslint-config": "workspace:*",
    "@eastgate/typescript-config": "workspace:*",
    "@graphql-codegen/cli": "^6.0.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.0.0",
    "@graphql-codegen/typescript-resolvers": "^6.0.2",
    "@graphql-codegen/typed-document-node": "^6.1.0",
    "@types/node": "^22.19.17",
    "eslint": "^9.39.4",
    "typescript": "^6.0.3"
  }
}
