generator client {
  provider        = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
  binaryTargets   = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x", "linux-musl"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector")]
}

// =========================================================================================================================
// AUTHENTICATION MODELS
// =========================================================================================================================

enum SystemRole {
  System
  Admin
  Editor
  User
}

enum MembershipStatus {
  Guest
  Member
}

model User {
  user          Int     @id @default(autoincrement())
  id            String  @unique @default(uuid())
  firebaseUid   String  @unique
  email         String  @unique
  name          String
  image         String?
  emailVerified Boolean @default(false)

  banned     Boolean   @default(false)
  banReason  String?
  banExpires DateTime?

  systemRole       SystemRole       @default(User)
  membershipStatus MembershipStatus @default(Guest)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile            Profile?
  deaconProfile      DeaconProfile?
  membershipProgress MembershipProgress?
  staffProfile       StaffProfile?

  ledMinistries         Ministry[]          @relation("MinistryHead")
  ledDepartments        Department[]        @relation("DepartmentHead")
  ministryMemberships   MinistryMember[]
  departmentMemberships DepartmentMember[]
  orders                Order[]
  donations             Donation[]
  registrations         EventRegistration[]
  materialDonations     MaterialDonation[]
  pledges               Pledge[]
  volunteerSignUps      VolunteerSignUp[]
  prayerRequests        PrayerRequest[]
  communityPosts        CommunityPost[]     @relation("ContentAuthor")

  @@index([email])
  @@map("user")
}

model Profile {
  profile     Int     @id @default(autoincrement())
  id          String  @unique @default(uuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  phoneNumber String?

  avatarUrls     String[]
  backgroundUrls String[]

  joinedDate DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profile")
}

model StaffProfile {
  staffProfile   Int      @id @default(autoincrement())
  id             String   @unique @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  phoneNumber    String?
  avatarUrls     String[]
  backgroundUrls String[]
  title          String
  joinedAt       DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("staff_profile")
}

model DeaconProfile {
  deaconProfile  Int       @id @default(autoincrement())
  id             String    @unique @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  phoneNumber    String?
  avatarUrls     String[]
  backgroundUrls String[]
  ordinationDate DateTime?
  isActive       Boolean   @default(true)
  pdbRole        String?
  termStartDate  DateTime?
  termEndDate    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("deacon_profile")
}

model MembershipProgress {
  membershipProgress  Int       @id @default(autoincrement())
  id                  String    @unique @default(uuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isBaptized          Boolean   @default(false)
  completedShapeClass Boolean   @default(false)
  verifiedAt          DateTime?

  @@map("membership_progress")
}

// Responsibility: Community & Ministry Administration
// Models that govern structural governance nodes within the church ecosystem,
// including overarching ministries, broken-down internal departments, and direct member associations.

model Ministry {
  ministry          Int                @id @default(autoincrement())
  id                String             @unique @default(uuid())
  name              String             @unique
  description       String?            @db.Text
  headId            String?
  head              User?              @relation("MinistryHead", fields: [headId], references: [id], onDelete: SetNull)
  departments       Department[]
  members           MinistryMember[]
  products          Product[]
  events            Event[]
  donations         Donation[]
  materialDonations MaterialDonation[]
  pledges           Pledge[]

  @@map("ministry")
}

model Department {
  department        Int                @id @default(autoincrement())
  id                String             @unique @default(uuid())
  name              String
  ministryId        String
  ministry          Ministry           @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  headId            String?
  head              User?              @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  members           DepartmentMember[]
  products          Product[]
  events            Event[]
  donations         Donation[]
  materialDonations MaterialDonation[]
  pledges           Pledge[]

  @@unique([name, ministryId])
  @@map("department")
}

model MinistryMember {
  ministryMember Int      @id @default(autoincrement())
  id             String   @unique @default(uuid())
  ministryId     String
  parent         Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime @default(now())

  @@unique([ministryId, userId])
  @@map("ministry_member")
}

model DepartmentMember {
  departmentMember Int        @id @default(autoincrement())
  id               String     @unique @default(uuid())
  departmentId     String
  parent           Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt         DateTime   @default(now())

  @@unique([departmentId, userId])
  @@map("department_member")
}

model PrayerRequest {
  prayerRequest Int      @id @default(autoincrement())
  id            String   @unique @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  requesterName String
  content       String   @db.Text
  isPublic      Boolean  @default(false)
  isResolved    Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@map("prayer_request")
}

// Responsibility: Content Management System (CMS)
// Manages social feeds, galleries, curated sermon items, series records, and notices
// deployed to inform or engage the congregation on public interfaces.

enum PostCategory {
  SUNDAY_SERVICE
  MIDWEEK_SERVICE
  MINISTRY_EVENT
  SCHOOL_EVENT
  HOUSE_GROUP
  BIBLE_STUDY
}

enum AnnouncementAudience {
  CHURCH_WIDE
  SCHOOL_ONLY
  MINISTRY_SPECIFIC
}

model CommunityPost {
  communityPost Int          @id @default(autoincrement())
  id            String       @unique @default(uuid())
  category      PostCategory
  title         String
  caption       String       @db.Text
  themeText     String?
  mediaUrls     String[]
  eventId       String?
  event         Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  authorId      String
  author        User         @relation("ContentAuthor", fields: [authorId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("community_post")
}

model DailyVerse {
  dailyVerse  Int      @id @default(autoincrement())
  id          String   @unique @default(uuid())
  verseLine   String
  reference   String
  publishDate DateTime @unique
  createdAt   DateTime @default(now())

  @@map("daily_verse")
}

model SermonSeries {
  sermonSeries Int      @id @default(autoincrement())
  id           String   @unique @default(uuid())
  title        String
  description  String?  @db.Text
  coverUrl     String?
  createdAt    DateTime @default(now())
  sermons      Sermon[]

  @@map("sermon_series")
}

model Sermon {
  sermon       Int           @id @default(autoincrement())
  id           String        @unique @default(uuid())
  title        String
  description  String?       @db.Text
  videoUrl     String?
  audioUrl     String?
  thumbnailUrl String?
  preacher     String
  preachedAt   DateTime
  seriesId     String?
  series       SermonSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  slideUrls    String[]
  handoutUrls  String[]
  createdAt    DateTime      @default(now())

  @@map("sermon")
}

model Announcement {
  announcement Int                  @id @default(autoincrement())
  id           String               @unique @default(uuid())
  title        String
  content      String               @db.Text
  posterUrl    String?
  audience     AnnouncementAudience @default(CHURCH_WIDE)
  isPinned     Boolean              @default(false)
  expiresAt    DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@map("announcement")
}

// Responsibility: Events & Volunteer Infrastructure
// Handles physical or virtual gathering coordination, ticketing controls,
// partner associations, and community team rosters supporting single event projects.

enum EventScope {
  IN_HOUSE
  MINISTRY_DEPARTMENT
  COLLABORATION
}

enum RegistrationStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
}

model Event {
  event                  Int                        @id @default(autoincrement())
  id                     String                     @unique @default(uuid())
  title                  String
  description            String                     @db.Text
  location               String
  startsAt               DateTime
  endsAt                 DateTime
  maxCapacity            Int?
  posterUrl              String?
  scope                  EventScope                 @default(IN_HOUSE)
  price                  Decimal                    @default(0.00) @db.Decimal(10, 2)
  ministryId             String?
  ministry               Ministry?                  @relation(fields: [ministryId], references: [id], onDelete: SetNull)
  departmentId           String?
  department             Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  partnerId              String?
  partner                ExternalPartner?           @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  donations              Donation[]
  materialDonations      MaterialDonation[]
  materialCampaigns      MaterialDonationCampaign[]
  pledges                Pledge[]
  registrations          EventRegistration[]
  posts                  CommunityPost[]
  products               Product[]
  volunteerOpportunities VolunteerSignUp[]
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@map("event")
}

model ExternalPartner {
  externalPartner Int      @id @default(autoincrement())
  id              String   @unique @default(uuid())
  name            String   @unique
  contactName     String?
  email           String?
  phoneNumber     String?
  events          Event[]
  createdAt       DateTime @default(now())

  @@map("external_partner")
}

model EventRegistration {
  eventRegistration Int                  @id @default(autoincrement())
  id                String               @unique @default(uuid())
  eventId           String
  event             Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            RegistrationStatus   @default(CONFIRMED)
  registeredAt      DateTime             @default(now())
  transactions      PaymentTransaction[]

  @@unique([eventId, userId])
  @@map("event_registration")
}

model VolunteerSignUp {
  volunteerSignup Int      @id @default(autoincrement())
  id              String   @unique @default(uuid())
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredRole   String?
  notes           String?  @db.Text
  signedUpAt      DateTime @default(now())

  @@unique([eventId, userId])
  @@map("volunteer_signup")
}

// Responsibility: E-Commerce Engine
// Handles structural commercial components, item tracking under discrete variants,
// procurement checkout frameworks, and explicit fulfillment configuration tracking.

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum FulfillmentMethod {
  HOME_DELIVERY
  CHURCH_PICKUP
}

model Category {
  category Int       @id @default(autoincrement())
  id       String    @unique @default(uuid())
  name     String    @unique
  products Product[]

  @@map("category")
}

model Product {
  product      Int              @id @default(autoincrement())
  id           String           @unique @default(uuid())
  name         String
  description  String           @db.Text
  price        Decimal          @db.Decimal(10, 2)
  categoryId   String
  category     Category         @relation(fields: [categoryId], references: [id])
  variants     ProductVariant[]
  orderItems   OrderItem[]
  ministryId   String?
  ministry     Ministry?        @relation(fields: [ministryId], references: [id], onDelete: SetNull)
  departmentId String?
  department   Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  eventId      String?
  event        Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())

  @@map("product")
}

model ProductVariant {
  productVariant Int         @id @default(autoincrement())
  id             String      @unique @default(uuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String      @unique
  size           String?
  color          String?
  stockCount     Int         @default(0)
  orderItems     OrderItem[]

  @@map("product_variant")
}

model Order {
  order             Int                  @id @default(autoincrement())
  id                String               @unique @default(uuid())
  userId            String?
  user              User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  status            OrderStatus          @default(PENDING)
  totalAmount       Decimal              @db.Decimal(10, 2)
  fulfillmentMethod FulfillmentMethod    @default(CHURCH_PICKUP)
  shippingAddress   String?              @db.Text
  trackingNumber    String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  items             OrderItem[]
  transactions      PaymentTransaction[]

  @@map("order")
}

model OrderItem {
  orderItem        Int             @id @default(autoincrement())
  id               String          @unique @default(uuid())
  orderId          String
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  productVariantId String?
  variant          ProductVariant? @relation(fields: [productVariantId], references: [id])
  quantity         String
  priceAtPurchase  Decimal         @db.Decimal(10, 2)

  @@map("order_item")
}

// Responsibility: Financial Ledger, Donations & Pledging
// Manages all monetary and non-monetary giving pipelines, target asset drives,
// strategic multi-part pledges, and the unified transactional logging for M-Pesa STK push.

enum FinancialPurpose {
  TITHE
  OFFERING
  GENERAL_FUND_ALLOCATION
}

enum PledgeStatus {
  PENDING
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

enum MaterialCategory {
  FOOD
  CLOTHES
  EQUIPMENT
  OTHER
}

model DonationCampaign {
  donationCampaign Int        @id @default(autoincrement())
  id               String     @unique @default(uuid())
  title            String
  description      String     @db.Text
  targetGoal       Decimal?   @db.Decimal(12, 2)
  isActive         Boolean    @default(true)
  donations        Donation[]
  pledges          Pledge[]
  createdAt        DateTime   @default(now())

  @@map("donation_campaign")
}

model Donation {
  donation        Int                  @id @default(autoincrement())
  id              String               @unique @default(uuid())
  userId          String?
  user            User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  campaignId      String?
  campaign        DonationCampaign?    @relation(fields: [campaignId], references: [id])
  purpose         FinancialPurpose     @default(GENERAL_FUND_ALLOCATION)
  amount          Decimal              @db.Decimal(12, 2)
  isAnonymous     Boolean              @default(false)
  ministryId      String?
  ministry        Ministry?            @relation(fields: [ministryId], references: [id], onDelete: SetNull)
  departmentId    String?
  department      Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  eventId         String?
  event           Event?               @relation(fields: [eventId], references: [id], onDelete: SetNull)
  isSchoolProject Boolean              @default(false)
  pledgeId        String?
  pledge          Pledge?              @relation(fields: [pledgeId], references: [id], onDelete: SetNull)
  transactions    PaymentTransaction[]
  createdAt       DateTime             @default(now())

  @@map("donation")
}

model MaterialDonationCampaign {
  materialDonationCampaign Int                            @id @default(autoincrement())
  id                       String                         @unique @default(uuid())
  title                    String
  description              String                         @db.Text
  isActive                 Boolean                        @default(true)
  eventId                  String?
  event                    Event?                         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  items                    MaterialDonationCampaignItem[]
  donations                MaterialDonation[]
  createdAt                DateTime                       @default(now())

  @@map("material_donation_campaign")
}

model MaterialDonationCampaignItem {
  materialDonationCampaignItem Int                      @id @default(autoincrement())
  id                           String                   @unique @default(uuid())
  materialCampaignId           String
  campaign                     MaterialDonationCampaign @relation(fields: [materialCampaignId], references: [id], onDelete: Cascade)
  itemName                     String
  targetQuantity               Int
  unit                         String

  @@map("material_donation_campaign_item")
}

model MaterialDonation {
  materialDonation   Int                       @id @default(autoincrement())
  id                 String                    @unique @default(uuid())
  userId             String?
  user               User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  category           MaterialCategory
  itemDescription    String                    @db.Text
  quantityText       String
  dropOffDate        DateTime?
  isReceived         Boolean                   @default(false)
  materialCampaignId String?
  materialCampaign   MaterialDonationCampaign? @relation(fields: [materialCampaignId], references: [id], onDelete: SetNull)
  ministryId         String?
  ministry           Ministry?                 @relation(fields: [ministryId], references: [id], onDelete: SetNull)
  departmentId       String?
  department         Department?               @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  eventId            String?
  event              Event?                    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  isSchoolProject    Boolean                   @default(false)
  pledgeId           String?
  pledge             Pledge?                   @relation(fields: [pledgeId], references: [id], onDelete: SetNull)
  createdAt          DateTime                  @default(now())

  @@map("material_donation")
}

model Pledge {
  pledge             Int                @id @default(autoincrement())
  id                 String             @unique @default(uuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             PledgeStatus       @default(PENDING)
  dueDate            DateTime?
  pledgedAmount      Decimal?           @db.Decimal(12, 2)
  monetaryDonations  Donation[]
  pledgedItemName    String?
  pledgedItemQty     Int?
  pledgedItemUnit    String?
  materialDonations  MaterialDonation[]
  donationCampaignId String?
  donationCampaign   DonationCampaign?  @relation(fields: [donationCampaignId], references: [id], onDelete: SetNull)
  ministryId         String?
  ministry           Ministry?          @relation(fields: [ministryId], references: [id], onDelete: SetNull)
  departmentId       String?
  department         Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  eventId            String?
  event              Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)
  isSchoolProject    Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@map("pledge")
}

model PaymentTransaction {
  paymentTransaction  Int                @id @default(autoincrement())
  id                  String             @unique @default(uuid())
  gateway             String
  checkoutRequestId   String             @unique
  merchantRequestId   String
  reference           String?            @unique
  status              String
  amount              Decimal            @db.Decimal(12, 2)
  rawGatewayResponse  String?            @db.Text
  orderId             String?
  order               Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  donationId          String?
  donation            Donation?          @relation(fields: [donationId], references: [id], onDelete: SetNull)
  eventRegistrationId String?
  eventRegistration   EventRegistration? @relation(fields: [eventRegistrationId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())

  @@map("payment_transaction")
}

// Responsibility: Communications & Auditing
// Disconnected logging models configured to capture analytical interaction history,
// user outbound message metrics, and external mailing list profiles.

model EmailSubscriber {
  emailSubscriber Int      @id @default(autoincrement())
  id              String   @unique @default(uuid())
  email           String   @unique
  isActive        Boolean  @default(true)
  subscribedAt    DateTime @default(now())

  @@map("email_subscriber")
}

model NotificationLog {
  notificationLog Int      @id @default(autoincrement())
  id              String   @unique @default(uuid())
  recipient       String
  title           String
  body            String   @db.Text
  sentType        String
  status          String
  sentAt          DateTime @default(now())

  @@map("notification_log")
}
