{
  "name": "eastgate",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "codegen": "pnpm --filter @eastgate/graphql codegen",
    "check-types": "turbo run check-types",
    "clean": "rm -rf pnpm-lock.yaml node_modules .turbo && rm -rf node_modules .next dist .output .turbo",
    "db:migrate": "pnpm --filter @eastgate/server db:migrate",
    "db:reset": "pnpm --filter @eastgate/server db:reset",
    "db:studio": "pnpm --filter @eastgate/server db:studio",
    "db:generate": "pnpm --filter @eastgate/server db:generate",
    "db:m:deploy": "pnpm --filter @eastgate/server db:migrate:deploy"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=24"
  }
}
